{
  "name": "@konvert7/promoot",
  "version": "0.2.1",
  "description": "Render a Promoot sponsor slot inline as a React server component, with views counted by the visitor's own browser.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "keywords": [
    "promoot",
    "sponsor",
    "slot",
    "react",
    "rsc",
    "server-component"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konvert7/promoot.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "prepare": "bun .husky/install.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@types/bun": "1.3.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "husky": "9.1.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3"
  }
}
